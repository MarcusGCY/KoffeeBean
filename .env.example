# Cursor API key (cursor.com/dashboard -> Integrations). Server only.
# Used by triage and by the in-process support agent. Not a hosted-agent deploy.
CURSOR_API_KEY=
# Optional model ids for the Cursor SDK agents. Unknown ids fall back to the default.
# TRIAGE_MODEL defaults to composer-2.5 with fast=false. FIX_MODEL defaults to
# claude-sonnet-5-5 with reasoning_effort=high and context=300k. An override uses that model's defaults.
# TRIAGE_MODEL=
# FIX_MODEL=
# Demo repo (owner/name). Must be connected to Cursor's GitHub app.
GITHUB_REPO=your-org/beanbox
# Fine-grained PAT: Contents read/write, Pull requests read/write, Issues read/write,
# Actions read and write.
# Contents write squash-merges onto main and commits demo reverts.
# Pull requests write reads the fix PR, squash-merges it, and marks a draft ready
# (GraphQL markPullRequestReadyForReview). Issues write comments, closes, and labels.
# Actions write dispatches the reproduction workflow on main. Actions read fetches its log.
GITHUB_TOKEN=
# Random string. Signs approve/reject links, demo revert grants, and support confirm actions.
APPROVAL_SECRET=change-me
# Public URL of this app (ngrok or Vercel URL). Used to sign approve/reject links.
APP_URL=http://localhost:3000
# Grok bot webhook (optional; if empty the /review/<n> page is the fallback)
GROK_WEBHOOK_URL=
# Full Authorization header value from the Feedback Bot routine panel (optional).
# Value may be Bearer … or the full Authorization: Bearer … line from the panel.
# Leave empty for an open webhook that does not require auth.
GROK_WEBHOOK_AUTH=

# Auth0 Regular Web Application (https://manage.auth0.com). No real secrets here.
# Domain only, e.g. your-tenant.us.auth0.com — not the https:// URL.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte hex key for the session cookie. Generate with: openssl rand -hex 32
AUTH0_SECRET=
# App origin Auth0 redirects back to. SDK v4 name (not AUTH0_BASE_URL).
APP_BASE_URL=http://localhost:3000
# Optional. Namespaced ID token claim that lists Auth0 RBAC role names.
# Leave unset to use https://beanbox/roles (the Post-Login Action in the README).
# Set this only when that Action writes a different claim name.
# AUTH0_ROLES_CLAIM=https://beanbox/roles

# Vercel only. Secret for the GitHub pull_request webhook (X-Hub-Signature-256).
GITHUB_WEBHOOK_SECRET=
# Vercel only. Bearer token for /api/fix-status (Vercel Cron and chained fix tracking).
CRON_SECRET=

# Auth0 machine-to-machine app for app_metadata (cart, orders, limits, audit).
# Domain is AUTH0_DOMAIN above.
# Authorize the Management API with read:users and update:users_app_metadata.
# read:users_app_metadata does not cover GET /api/v2/users/{id}.
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# Upstash Redis REST (free tier). Chat quotas and one-time confirm actions.
# No SDK. Console: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Neon Postgres connection string for the BI event log (analytics only; Auth0 stays the
# source of truth for carts and orders). Neon console -> Connect. Optional: when empty,
# BI writes are skipped and the app runs as before. Tables: db/migrations/0001_bi_events.sql (already applied on the Neon main branch).
DATABASE_URL=
# Secret key for hashing Auth0 `sub` into shopper_hash (HMAC-SHA256). 16+ characters.
# Generate with: openssl rand -hex 32. Without it BI events are skipped, never unhashed.
BI_HASH_SECRET=

# Production only. xAI key for support chat and POST /api/triage/classify. No value in git.
XAI_API_KEY=
# Bearer secret for POST /api/triage/classify. Compared with a hash, server only.
TRIAGE_API_SECRET=
# Optional. Defaults to grok-4.20-0309-non-reasoning.
TRIAGE_GROK_MODEL=

